# ==============================================================================
# CHRONON ENVIRONMENT CONFIGURATION
# Copy to .env for local development
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
POSTGRES_USER=chronon_user
POSTGRES_PASSWORD=chronon_password
POSTGRES_DB=chronon_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chronon_user:chronon_password@localhost:5432/chronon_db
DATABASE_URL_SYNC=postgresql://chronon_user:chronon_password@localhost:5432/chronon_db

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# OCR & Ingestion Settings
TESSERACT_CMD=tesseract
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Scheduling Solver Settings
CP_SAT_MAX_TIME_IN_SECONDS=120
CP_SAT_NUM_SEARCH_WORKERS=8
CP_SAT_LOG_SEARCH_PROGRESS=false
